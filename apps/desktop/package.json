{
  "name": "@watch-agent-pet/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Pluggable watch companion and cross-platform desktop client",
  "author": "mozzie",
  "main": "main/index.js",
  "dependencies": {
    "@watch-agent-pet/runtime": "0.1.0",
    "@watch-agent-pet/device-simulator": "0.1.0"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "playwright": "1.65.1"
  },
  "scripts": {
    "start": "electron .",
    "test:desktop": "node tests/smoke.js",
    "pack": "node tools/package.js --dir",
    "dist": "node tools/package.js"
  },
  "build": {
    "appId": "io.watchagentpet.desktop",
    "productName": "Watch Agent Pet",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "main/**",
      "preload/**",
      "renderer/**",
      "platforms/**",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
