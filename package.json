{
  "name": "watch-agent-pet",
  "version": "0.1.0",
  "description": "Pluggable watch companion and cross-platform desktop client",
  "author": "mozzie",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "apps/desktop/main.js",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:desktop": "node tools/desktop-smoke.js",
    "check": "node tools/check-source.js",
    "pack": "node tools/package-desktop.js --dir",
    "dist": "node tools/package-desktop.js",
    "bridge": "node apps/desktop/bridge-cli.js"
  },
  "dependencies": {"ws": "8.23.0"},
  "devDependencies": {"electron": "45.4.1", "electron-builder": "26.18.0", "playwright": "1.65.1"},
  "overrides": {"app-builder-lib": {"minimatch": "11.0.1"}, "@electron/universal": {"minimatch": "11.0.1"}},
  "build": {
    "appId": "io.watchagentpet.desktop",
    "productName": "Watch Agent Pet",
    "electronDist": "node_modules/electron/dist",
    "directories": {"output": "release"},
    "files": ["apps/desktop/**", "core/**/*.js", "contracts/**/*.js", "connectivity/**/*.js", "devices/simulator/**/*.js", "platforms/**/*.js", "integrations/**/*.js", "config/*.json", "config/*.js", "package.json"],
    "win": {"target": ["portable"], "signAndEditExecutable": false},
    "mac": {"target": ["zip"], "category": "public.app-category.productivity"},
    "linux": {"target": ["AppImage"], "category": "Utility"}
  }
}
