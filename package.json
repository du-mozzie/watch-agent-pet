{
  "name": "watch-agent-pet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/contracts",
    "packages/runtime",
    "packages/device-access/simulator",
    "apps/desktop",
    "apps/bridge"
  ],
  "scripts": {
    "start": "npm run start --workspace @watch-agent-pet/desktop",
    "bridge": "npm run start --workspace @watch-agent-pet/bridge --",
    "test": "npm run test --workspaces --if-present",
    "test:desktop": "npm run test:desktop --workspace @watch-agent-pet/desktop",
    "check": "node tools/check-source.js",
    "pack": "npm run pack --workspace @watch-agent-pet/desktop",
    "dist": "npm run dist --workspace @watch-agent-pet/desktop"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "11.0.1"
    },
    "@electron/universal": {
      "minimatch": "11.0.1"
    }
  }
}
